# Environments
.venv/
venv/
env/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Credentials
*.json.key
.ee_credentials
service_account*.json

# Large data / model artifacts (keep dirs via .gitkeep, ignore contents)
data/raw/*
data/masks/*
data/processed/*
!data/**/.gitkeep
# re-include per-region subdirs so the small provenance JSON below can be kept
!data/raw/*/
!data/masks/*/
*.tif
*.tiff
*.npy
*.npz
*.pt
*.pth
*.ckpt

# ...but keep the small text provenance artifacts (ground rule 2)
!data/raw/manifest.json
!data/raw/**/manifest.json
!data/masks/loss_label_summary.json
!data/masks/**/loss_label_summary.json
!data/processed/index.csv
!data/processed/split.json
!data/processed/loro.json
!data/processed/norm_stats.json

# Results binaries (keep metrics JSON/CSV and markdown, ignore heavy figures if needed)
results/figures/*.png
!results/figures/.gitkeep

# OS / Office temp files
.DS_Store
Thumbs.db
~$*

# Paper draft and phase notes - kept local, not tracked
/report.*
/docs/

# Frontend build artifacts (source is tracked; these are generated)
frontend/node_modules/
frontend/dist/
frontend/.vite/